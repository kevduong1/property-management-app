# ---------------------------------------------------------------------------
# Supabase (client) — safe to expose to the app; prefixed EXPO_PUBLIC_.
# Project Settings -> API
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Drizzle / migrations (server-side only — NOT shipped in the app bundle).
# Project Settings -> Database -> Connection string (URI). Use the pooler URL
# for `db:push` if direct connections are restricted.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Demo mode — when "true", the app uses an in-memory mock data layer so you can
# explore the UI without configuring Supabase. Set to "false" for real data.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DEMO_MODE=true

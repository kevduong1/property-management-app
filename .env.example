# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# In production set DATABASE_URL to your Postgres connection string (Supabase,
# Neon, RDS, etc.). When DATABASE_URL is unset, the app falls back to an
# embedded PGlite database stored in ./.pglite so it runs with zero infra.
# DATABASE_URL=postgres://user:password@localhost:5432/property_mgmt

# Force a specific driver. Values: "postgres" | "pglite". Optional.
# DB_DRIVER=pglite

# ---------------------------------------------------------------------------
# Supabase Auth (optional for local dev — see AUTH_MODE)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth mode: "dev" uses a cookie-based role switcher (no Supabase project
# required) so the MVP is fully demoable. "supabase" uses real Supabase Auth.
AUTH_MODE=dev

# ---------------------------------------------------------------------------
# File storage (documents)
# ---------------------------------------------------------------------------
# STORAGE_MODE: "local" writes uploads to ./.uploads (dev default).
# Set to "supabase" to use Supabase Storage.
STORAGE_MODE=local
SUPABASE_STORAGE_BUCKET=documents
